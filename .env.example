# Copiar este archivo como .env (el .env NO se sube a GitHub)
POSTGRES_DB=smartstock
POSTGRES_USER=smartstock
POSTGRES_PASSWORD=smartstock

# Secreto compartido entre core-service (firma los JWT) y analytics-service (los valida).
# Mínimo 32 caracteres. Cambiarlo en cualquier entorno que no sea desarrollo.
JWT_SECRET=smartstock-secreto-de-desarrollo-cambiar-en-produccion-0123456789abcdef
